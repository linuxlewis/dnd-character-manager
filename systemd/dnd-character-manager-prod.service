[Unit]
Description=D&D Character Manager Production Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/sbolgert/workspace/dnd-character-manager
ExecStartPre=/usr/bin/test -f /home/sbolgert/workspace/dnd-character-manager/.env.production
ExecStart=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
ExecStop=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

